        CHB.debuffed_mobs[id] = {
            [134] = { id = 25,  timer = os.clock() + 178, actor = CHB.debuffed_player_id },
            [13]  = { id = 79,  timer = os.clock() + 220, actor = CHB.debuffed_player_id + 1 },
            [4]   = { id = 58,  timer = os.clock() +  90, actor = CHB.debuffed_player_id },
