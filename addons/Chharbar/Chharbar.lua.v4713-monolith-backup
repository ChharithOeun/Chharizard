        n = math.max(1, math.min(12, math.floor(n)))
        self.settings.max_rows = n
        CHB.save_settings('hate'); CHB.hard_reset('hate')
        log_info('hate: max_rows=' .. n); return
    end
    if sub == 'test' then
        -- v4.0.1: attach test hate to CURRENT battle target so the widget
